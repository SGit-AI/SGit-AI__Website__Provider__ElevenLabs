<?xml version="1.0" encoding="UTF-8"?>
<!-- The vault-wide lexicon. Aliases are starting points; replace with a <phoneme> where an alias still
     comes out wrong (eleven_flash_v2 and eleven_v3 only). Upload with examples in docs/04; pin the
     returned id:version in README.md and pass ELEVEN_DICT=<id>:<version> to the render. -->
<lexicon version="1.0" xmlns="http://www.w3.org/2005/01/pronunciation-lexicon" alphabet="ipa" xml:lang="en-GB">
  <lexeme><grapheme>sgit</grapheme><alias>ess-git</alias></lexeme>
  <lexeme><grapheme>sgit.ai</grapheme><alias>ess-git dot A I</alias></lexeme>
  <lexeme><grapheme>SG/Vault</grapheme><alias>S G Vault</alias></lexeme>
  <lexeme><grapheme>SG/Send</grapheme><alias>S G Send</alias></lexeme>
  <lexeme><grapheme>SGraph</grapheme><alias>S graph</alias></lexeme>
  <lexeme><grapheme>AIUC-1</grapheme><alias>A I U C one</alias></lexeme>
  <lexeme><grapheme>AIUC</grapheme><alias>A I U C</alias></lexeme>
  <lexeme><grapheme>SHA-256</grapheme><alias>sha two five six</alias></lexeme>
  <lexeme><grapheme>llms.txt</grapheme><alias>L L M S dot text</alias></lexeme>
  <lexeme><grapheme>app.json</grapheme><alias>app dot jason</alias></lexeme>
  <lexeme><grapheme>OWASP</grapheme><alias>oh-wasp</alias></lexeme>
  <lexeme><grapheme>PT-BR</grapheme><alias>Brazilian Portuguese</alias></lexeme>
  <lexeme><grapheme>PT-PT</grapheme><alias>European Portuguese</alias></lexeme>
  <lexeme><grapheme>VoiceDebrief</grapheme><alias>Voice Debrief</alias></lexeme>
  <lexeme><grapheme>José</grapheme><phoneme>ʒuˈzɛ</phoneme></lexeme>
  <lexeme><grapheme>NIST</grapheme><alias>nist</alias></lexeme>
  <lexeme><grapheme>ISO 42001</grapheme><alias>I S O forty-two thousand and one</alias></lexeme>
  <lexeme><grapheme>EU AI Act</grapheme><alias>E U A I Act</alias></lexeme>
  <lexeme><grapheme>PPTX</grapheme><alias>PowerPoint</alias></lexeme>
</lexicon>
